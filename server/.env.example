# JWT signing secret — use a long random string in production
JWT_SECRET=

# Email address granted admin access
ADMIN_EMAIL=

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=

# Inngest (background jobs / cron) — from your Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# SMTP credentials for outgoing email (e.g. leave/payslip notifications)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Port the API server listens on (optional, defaults to 4000)
PORT=4000
